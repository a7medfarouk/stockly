@page "/orders/{Id:int}"
@inject OrderService OrderService

<PageTitle>Order #@Id - Stockly</PageTitle>

@if (isLoading)
{
    <div class="spinner"></div>
}
else if (order == null)
{
    <div class="alert alert-danger">Order not found.</div>
}
else
{
    <div class="page-header">
        <h1>Order #@order.Id</h1>
    </div>

    <div class="card mb-3">
        <p style="margin: 0 0 0.5rem; color: var(--text-dim); font-size: 0.85rem;">
            <span style="color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; font-weight: 600;">Date</span><br />
            <span style="color: var(--text); font-size: 1rem;">@order.OrderDate.ToString("MMM dd, yyyy")</span>
        </p>
        <p style="margin: 0.75rem 0 0; color: var(--text-dim); font-size: 0.85rem;">
            <span style="color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; font-weight: 600;">Total Amount</span><br />
            <span style="color: var(--success); font-size: 1.4rem; font-weight: 700;">$@order.TotalAmount.ToString("F2")</span>
        </p>
    </div>

    <div class="card">
        <h5>Items</h5>
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in order.Items)
                {
                    <tr>
                        <td style="color: var(--text); font-weight: 500;">@item.ProductName</td>
                        <td style="color: var(--text-dim);">@item.Quantity</td>
                        <td style="color: var(--text-dim);">$@item.UnitPrice.ToString("F2")</td>
                        <td style="color: var(--success); font-weight: 600;">$@((item.UnitPrice * item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a href="orders" class="btn btn-outline mt-3">Back to Orders</a>
}

@code {
    [Parameter] public int Id { get; set; }
    private OrderDto? order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetByIdAsync(Id);
        isLoading = false;
    }
}
